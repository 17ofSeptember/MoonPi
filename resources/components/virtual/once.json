{
  "schema": "moonpi-component",
  "schema_version": 1,
  "revision": 1,
  "id": "moonpi.logic.once",
  "name": "One-time schedule",
  "category": "Timing",
  "description": "A persistent one-time UTC trigger. Checkpoints prevent replay after restart.",
  "aliases": [],
  "driver": {
    "id": "moonpi.driver.once",
    "api_version": 1
  },
  "connections": [],
  "ports": [
    {
      "id": "tick",
      "type": "Trigger",
      "direction": "output"
    }
  ],
  "properties": {
    "at_utc": {
      "type": "string",
      "title": "UTC time (YYYY-MM-DDTHH:MM:SSZ)",
      "default": "2030-01-01T12:00:00Z"
    },
    "missed": {
      "type": "string",
      "title": "If time passed before Run",
      "default": "SKIP_MISSED",
      "enum": [
        "SKIP_MISSED",
        "RUN_ONCE_AFTER_START"
      ]
    }
  },
  "electrical": {
    "logic_voltage": 0,
    "max_current_ma": 0,
    "requires_level_shifter": false,
    "requires_resistor": false,
    "safe_state": false,
    "notes": "Requires explicit Run. Calendar uses UTC; interval and delay use monotonic time."
  },
  "documentation": "docs/SCHEDULING.md"
}
